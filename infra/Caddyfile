# Amazing Grace Reader - Caddy reverse proxy.
# Replace YOUR.DOMAIN below before running setup.sh, or set CADDY_DOMAIN.
YOUR.DOMAIN {
  encode zstd gzip

  # Long flush interval for streaming /api/tts responses from ElevenLabs.
  # Everything else uses the default reverse proxy.
  reverse_proxy 127.0.0.1:8770 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
    flush_interval -1
  }

  log {
    output file /var/log/caddy/access.log {
      roll_size 100MiB
      roll_keep 10
    }
  }
}
