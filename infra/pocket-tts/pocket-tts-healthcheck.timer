[Unit]
Description=Weekly Pocket TTS health check

[Timer]
# Sundays 03:00 UTC - low-traffic window, won't fight anything user-facing.
OnCalendar=Sun *-*-* 03:00:00 UTC
# Small jitter so multiple weekly timers don't all fire at the same second.
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
