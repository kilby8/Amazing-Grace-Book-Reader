[Unit]
Description=Snapshot pocket-tts install to restic (B2)
After=pocket-tts.service

[Service]
Type=oneshot
User=root
# Load the .env so the backup script can see B2_ACCOUNT_ID etc.
EnvironmentFile=/opt/amazing-grace/.env
ExecStart=/opt/pocket-tts/backup.sh
# restic to B2 can take a few minutes on first run (model cache is ~500MB).
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
