[Unit]
Description=Pocket TTS health check (restarts pocket-tts if it stops answering)
After=pocket-tts.service

[Service]
Type=oneshot
# Root, so it can restart the service. Loopback only - pocket-tts is not
# exposed outside the VM. Two misses in a row (about 30 s apart) mean the
# server is frozen or stuck on one request (/health says 503 then): restart it.
# On 2026-11-02 it froze and stayed frozen, since nothing restarted it.
ExecStart=/bin/sh -c 'curl -fsS --max-time 15 http://127.0.0.1:8765/health || { sleep 15; curl -fsS --max-time 15 http://127.0.0.1:8765/health; } || { echo "pocket-tts not answering; restarting"; systemctl restart pocket-tts; }'
StandardOutput=journal
StandardError=journal
