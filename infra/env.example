# Amazing Grace Reader - production environment.
# Copy this to /opt/amazing-grace/.env and edit. systemd reads it on start.

NODE_ENV=production
PORT=8770
HOST=127.0.0.1
SESSION_SECRET=                  # REQUIRED in production; setup.sh generates one
DATA_DIR=/opt/amazing-grace/data  # per-user library DB + book blobs
ELEVENLABS_KEY_FILE=/etc/amazing-grace/elevenlabs_credentials.json
# ELEVENLABS_API_KEY=sk_...       # alternative to the file path; takes precedence

# Caddy domain - replace YOUR.DOMAIN before running setup.sh
# CADDY_DOMAIN=reader.example.com
